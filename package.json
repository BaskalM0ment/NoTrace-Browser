{
  "name": "notrace-browser",
  "version": "1.0.0",
  "description": "A lightweight Electron browser with DuckDuckGo search, tabs, and a minimal interface.",
  "main": "main.js",
  "author": "BaskalM0ment",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.notrace.browser",
    "productName": "NoTrace Browser",
    "files": [
      "index.html",
      "main.js",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    }
  }
}
